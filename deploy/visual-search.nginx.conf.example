# REVIEW ONLY: insert in the existing HTTPS server, after a separately approved deployment.
# Keep the existing / root redirect and proxy_redirect untouched.
location ^~ /api/visual-search/ {
    client_max_body_size 2m;
    client_body_buffer_size 2m;
    client_body_in_single_buffer on;
    client_body_in_file_only off;
    client_body_timeout 3s;
    proxy_pass http://127.0.0.1:18983;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_connect_timeout 1s;
    proxy_send_timeout 4s;
    proxy_read_timeout 9s;
    access_log off;
    add_header Cache-Control "no-store" always;
}
